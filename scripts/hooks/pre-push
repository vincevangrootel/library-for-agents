#!/usr/bin/env python3
"""Refuse to push a private library to a public GitHub repository.

Git calls this with the remote name and URL. If the URL is on github.com and GitHub
reports the repository as public, the push is stopped. Private repositories (which
GitHub hides from anonymous requests) and other hosts pass. Bypass, if you really mean
it: git push --no-verify
"""
import json, re, sys, urllib.request

url = sys.argv[2] if len(sys.argv) > 2 else ''
m = re.search(r'github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$', url)
if not m:
    sys.exit(0)
try:
    with urllib.request.urlopen(f'https://api.github.com/repos/{m[1]}/{m[2]}', timeout=10) as r:
        public = json.load(r).get('private') is False
except urllib.error.HTTPError as e:
    public = False if e.code == 404 else None
except Exception:
    public = None
if public:
    sys.exit(f'refusing to push: {m[1]}/{m[2]} is a PUBLIC GitHub repository and this library holds your books.\n'
             'Use a private repository. To override: git push --no-verify')
if public is None:
    print('pre-push: could not confirm the GitHub repository is private; pushing anyway', file=sys.stderr)
